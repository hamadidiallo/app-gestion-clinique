# =============================================================================
# Modèle de configuration pour la PRODUCTION
# Copier en .env sur le serveur, puis exécuter : php artisan key:generate
# Ne jamais versionner le fichier .env réel.
# =============================================================================

APP_NAME="Gestion Clinique"
APP_ENV=production
APP_KEY=
# Impératif : APP_DEBUG=true expose la configuration et les traces d'erreur
APP_DEBUG=false
APP_URL=https://medigest.dukani.tech

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# PostgreSQL partagé avec Dukani (conteneur dukani_postgres, réseau dukani_default).
# L'utilisateur medigest n'a accès qu'à la base medigest. Son mot de passe est
# dans ~/medigest/.db_password sur le serveur : voir LISEZMOI-deploiement.md.
DB_CONNECTION=pgsql
DB_HOST=dukani_postgres
DB_PORT=5432
DB_DATABASE=medigest
DB_USERNAME=medigest
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Chiffrement des sessions : obligatoire pour des données de santé
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=medigest.dukani.tech
# Cookies transmis uniquement via HTTPS
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nécessite un superviseur exécutant : php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database

# Transport mail réel : sans lui, les invitations ne partent pas
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@dukani.tech"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Coordonnées affichées sur la page vitrine (laisser vide pour masquer)
MEDIGEST_CONTACT_WHATSAPP=
MEDIGEST_CONTACT_TELEPHONE=
MEDIGEST_CONTACT_EMAIL=
