# =============================================================================
# Modèle de configuration pour la PRODUCTION
# Copier en .env sur le serveur, puis exécuter : php artisan key:generate
# Ne jamais versionner le fichier .env réel.
# =============================================================================

APP_NAME="Gestion Clinique"
APP_ENV=production
APP_KEY=
# Impératif : APP_DEBUG=true expose la configuration et les traces d'erreur
APP_DEBUG=false
APP_URL=https://votre-domaine.example

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestionclinique
# Utilisateur dédié, jamais root, avec un mot de passe fort
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Chiffrement des sessions : obligatoire pour des données de santé
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=votre-domaine.example
# Cookies transmis uniquement via HTTPS
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nécessite un superviseur exécutant : php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database

# Transport mail réel : sans lui, les invitations ne partent pas
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@votre-domaine.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
